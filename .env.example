# spark-to-paper-skills — UNIFIED secrets/config.
# Copy to ./.env (gitignored, never commit). Auto-loaded by the skill scripts (_dotenv.py).
# A real exported env var always overrides a value here.

# --- GPT vision/text (ts-figure-optimize hybrid text-correction + vision diff) ---
# Optional: if unset, these fall back to ~/.codex/auth.json.
OPENAI_API_KEY=
VISION_MODEL=gpt-5.5
VISION_BASE_URL=

# --- Embeddings (ts-kg-build, ts-idea2story) ---
TS_EMBED_API_KEY=
TS_EMBED_BASE_URL=https://api.openai.com/v1
TS_EMBED_MODEL=

# --- Image generation (ts-paper-figure free-form schematics) ---
# EXPLICITLY pick the image model here. Default gpt-image-2; alternatives:
#   gpt-image-2 | gpt-image-1 | dall-e-3 | gemini-3.1-flash-image-preview | any OpenAI-compatible image model.
TS_FIG_MODEL=gpt-image-2
TS_FIG_API_KEY=
TS_FIG_BASE_URL=                 # OpenAI-compatible base, e.g. https://api.openai.com/v1
TS_FIG_API_STYLE=images          # images = OpenAI /images/generations (gpt-image-*, dall-e) ; chat = /chat/completions (gemini etc.)
TS_FIG_SIZE=1536x1024            # landscape default for diagrams
TS_FIG_QUALITY=high              # gpt-image-* quality knob

# --- Skill-owned PaperBanana reference-data cache (optional override) ---
PAPERBANANA_CACHE_ROOT=$HOME/.cache/ts-paper-figure

# --- DrawAI external model-service connection (client machine) ---
# One server can expose all three endpoints. HTTPS or a loopback SSH tunnel is recommended.
DRAWAI_REMOTE_BASE_URL=
DRAWAI_REMOTE_API_KEY=
DRAWAI_REMOTE_API_KEY_HEADER=Authorization
DRAWAI_REMOTE_API_KEY_SCHEME=Bearer
DRAWAI_REMOTE_CA_BUNDLE=
DRAWAI_REMOTE_REQUEST_TIMEOUT_SECONDS=600
DRAWAI_REMOTE_QUEUE_TIMEOUT_SECONDS=180
DRAWAI_REMOTE_QUEUE_MAX_POLLS=180
DRAWAI_REMOTE_HEALTH_TIMEOUT_SECONDS=10
DRAWAI_REMOTE_HEALTH_ATTEMPTS=2
DRAWAI_REMOTE_RETRY_MAX_ATTEMPTS=3
# Optional only when SAM3/OCR/RMBG are split across servers:
DRAWAI_REMOTE_SAM3_URL=
DRAWAI_REMOTE_OCR_URL=
DRAWAI_REMOTE_RMBG_URL=
# Direct clear-text HTTP to a non-loopback address is rejected unless explicitly acknowledged:
DRAWAI_REMOTE_ALLOW_INSECURE_HTTP=0
# Diagnostics only; normal publication runs require GPU-reported SAM3/RMBG:
DRAWAI_REMOTE_ALLOW_CPU_HEAVY_MODELS=0

# --- Experiment execution (remote server first, local only before environment lock) ---
TS_EXPERIMENT_EXECUTION_POLICY=remote_first  # remote_first | remote_only | local_only
TS_EXPERIMENT_REMOTE_HOST=
TS_EXPERIMENT_REMOTE_USER=
TS_EXPERIMENT_REMOTE_PORT=22
TS_EXPERIMENT_REMOTE_ROOT=/tmp/ts-experiment-runs
TS_EXPERIMENT_REMOTE_ENV_FILE=              # optional env file that already exists on the server
TS_EXPERIMENT_SSH_IDENTITY_FILE=             # optional; SSH agent/config also works
TS_EXPERIMENT_SSH_KNOWN_HOSTS=               # optional custom known_hosts; strict checking is always on
TS_EXPERIMENT_SSH_CONNECT_TIMEOUT_SECONDS=15
TS_EXPERIMENT_SYNC_TIMEOUT_SECONDS=900
TS_EXPERIMENT_ALLOW_LOCAL_FALLBACK=1

# --- Remote GPU host provisioning only (never needed on the Codex client) ---
# HF_TOKEN is used only by setup_drawai.py --server-side when the remote host downloads gated SAM3.
HF_TOKEN=

# NOTE: DrawAI controlled SVG generation authenticates via ~/.codex/auth.json, not TS_FIG_API_KEY.
