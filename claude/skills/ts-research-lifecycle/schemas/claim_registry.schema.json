{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_registry",
  "type": "object",
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_text",
          "claim_type",
          "essential",
          "strength",
          "scope",
          "required_evidence",
          "support_status"
        ]
      }
    }
  }
}
