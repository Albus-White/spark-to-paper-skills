{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "user_policy_v5",
  "type": "object",
  "required": ["source", "target_venue", "venue_selection_policy", "citation_policy", "figure_policy", "requirements", "research_preferences", "deadline", "resource_limits", "human_review", "priorities", "degradation_policy", "assumptions"],
  "properties": {
    "source": {"enum": ["USER_PROVIDED", "USER_CONFIRMED_ASSUMPTIONS", "COMPILED_FROM_USER_REQUEST"]},
    "target_venue": {"type": ["string", "null"]},
    "venue_selection_policy": {"enum": ["USER_SELECTED", "RELEVANT_TOP_VENUES_IF_UNSPECIFIED"]},
    "citation_policy": {
      "type": "object",
      "properties": {"minimum_unique_cited_references": {"type": ["integer", "null"], "minimum": 0}}
    },
    "figure_policy": {
      "type": "object",
      "required": ["measured_evidence_route", "original_observation_route", "exact_structure_route", "explanatory_synthesis_route", "drawai_policy"],
      "properties": {
        "measured_evidence_route": {"const": "DETERMINISTIC_OR_ORIGINAL_EVIDENCE"},
        "original_observation_route": {"const": "ORIGINAL_EVIDENCE"},
        "exact_structure_route": {"const": "DOMAIN_NATIVE"},
        "explanatory_synthesis_route": {"const": "PAPERBANANA_REQUIRED"},
        "drawai_policy": {"const": "USE_IF_AVAILABLE_AFTER_RASTER_APPROVAL"}
      }
    },
    "requirements": {"type": "array"},
    "research_preferences": {"type": "object", "required": ["field", "paper_archetype"]},
    "deadline": {"type": "object", "minProperties": 1},
    "resource_limits": {"type": "object", "required": ["compute", "financial", "api", "storage"]},
    "human_review": {"type": "object"},
    "priorities": {"type": "array", "minItems": 1},
    "degradation_policy": {"type": "object", "required": ["acceptable", "unacceptable"]},
    "assumptions": {"type": "object", "required": ["unknowns", "confirmed"]}
  }
}
