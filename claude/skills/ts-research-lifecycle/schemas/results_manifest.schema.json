{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "results_manifest_fact",
  "type": "object",
  "required": [
    "fact_id",
    "claim_ids",
    "value",
    "unit",
    "run_ids",
    "source_artifacts",
    "source_hashes",
    "aggregation"
  ],
  "properties": {
    "fact_id": {"type": "string", "pattern": "^F-[0-9]+$"},
    "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "value": {},
    "unit": {"type": "string", "minLength": 1},
    "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_hashes": {"type": "object"},
    "aggregation": {
      "type": "object",
      "required": ["method", "code_artifact", "code_hash"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "code_artifact": {"type": "string", "minLength": 1},
        "code_hash": {"type": "string", "minLength": 64, "maxLength": 64}
      }
    }
  }
}
