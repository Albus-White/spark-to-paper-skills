{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "venue_study",
  "type": "object",
  "required": [
    "official_guidance",
    "representative_papers",
    "field_conventions",
    "user_requirements",
    "design_decisions",
    "limitations",
    "reviewer"
  ],
  "properties": {
    "official_guidance": {"type": "array"},
    "representative_papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "doi": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        },
        "anyOf": [{"required": ["url"]}, {"required": ["doi"]}, {"required": ["path"]}]
      }
    },
    "field_conventions": {"type": "array"},
    "user_requirements": {"type": "object"},
    "design_decisions": {"type": "object"},
    "limitations": {"type": "array"},
    "reviewer": {"type": "object", "minProperties": 1}
  }
}
