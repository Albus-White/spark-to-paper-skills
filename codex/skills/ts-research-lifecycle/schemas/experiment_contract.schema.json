{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "experiment_contract_v3",
  "type": "object",
  "required": [
    "claim_ids",
    "experiments",
    "study_inputs",
    "protocols",
    "outcomes",
    "comparators",
    "replication_plan",
    "statistical_plan",
    "test_set_policy",
    "stop_conditions",
    "budget",
    "feasibility"
  ],
  "properties": {
    "contract_schema_version": {"const": "3.0.0"},
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "experiment_id",
          "claim_ids",
          "why_it_tests_claim",
          "positive_interpretation",
          "negative_interpretation",
          "confounders",
          "out_of_scope_conclusions"
        ]
      }
    },
    "study_inputs": {"type": "array", "minItems": 1},
    "protocols": {"type": "array", "minItems": 1},
    "outcomes": {"type": "array", "minItems": 1},
    "comparators": {"type": "array", "minItems": 1},
    "replication_plan": {
      "type": "object",
      "required": ["type", "identifiers", "rationale"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "minItems": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_runs", "max_branches", "max_branch_depth"],
      "properties": {
        "max_runs": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_branches": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_branch_depth": {"type": "integer", "minimum": 0, "maximum": 4},
        "resource_envelope": {"type": "string"},
        "resource_envelope_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "deadline_fit": {"const": true},
        "allocation_rationale": {"type": "string", "minLength": 1}
      }
    },
    "feasibility": {
      "type": "object",
      "required": ["status"]
    }
  }
}
