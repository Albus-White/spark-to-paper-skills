{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "venue_corpus_v5",
  "type": "object",
  "required": ["user_policy_id", "user_policy_hash", "science_profile_id", "science_profile_hash", "venue_basis", "research_scope", "paper_archetype", "inclusion_criteria", "exclusion_criteria", "time_window", "publication_status", "stopping_rule", "candidate_sources", "reviewer"],
  "properties": {
    "candidate_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paper_id", "title", "venue", "accepted_status"],
        "anyOf": [{"required": ["doi"]}, {"required": ["official_url"]}]
      }
    }
  }
}
