{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research_state",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "phase",
    "active",
    "gates",
    "invalidations",
    "approvals",
    "blockers",
    "history",
    "policy"
  ],
  "properties": {
    "profile": {
      "enum": [
        "proposal",
        "exploratory",
        "standard_empirical",
        "high_risk"
      ]
    },
    "phase": {
      "type": "string"
    },
    "active": {
      "type": "object",
      "required": ["user_policy_id", "idea_seed_id", "memory_snapshot_id", "science_profile_id", "venue_corpus_id", "venue_profile_id", "venue_profile_judgment_id", "idea_candidates_id", "idea_selection_id", "idea_id", "research_program_id", "publication_contract_id", "bibliography_coverage", "figure_routing", "manuscript_id", "publication_judgment_id", "schedule_checkpoint", "release_audit_id"]
    },
    "gates": {
      "type": "object"
    },
    "invalidations": {
      "type": "array"
    },
    "approvals": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "history": {
      "type": "array"
    },
    "policy": {
      "type": "object",
      "required": ["phase_sequence", "required_gates"]
    }
  }
}
