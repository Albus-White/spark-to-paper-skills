{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "science_profile_v5",
  "type": "object",
  "required": ["idea_seed_id", "idea_seed_hash", "research_scope", "corpus_protocol", "primary_sources", "closest_work", "benchmark_landscape", "scientific_conventions", "evidence_conventions", "writing_conventions", "open_questions", "freshness", "limitations", "reviewer"],
  "properties": {
    "primary_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "venue", "year", "source", "full_text", "relevance", "read_scope"]
      }
    },
    "closest_work": {"type": "array", "minItems": 1},
    "benchmark_landscape": {"type": "object"},
    "scientific_conventions": {"type": "object"},
    "evidence_conventions": {"type": "object"},
    "writing_conventions": {"type": "object"}
  }
}
